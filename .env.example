# Milestones Coffee 2.0 — Environment Variables
# Copy to .env.local for local development. Never commit real values.

# === API ===
API_PORT=4000
API_BASE_URL=http://localhost:4000

# === Database ===
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/milestones_dev

# === Redis ===
REDIS_URL=redis://localhost:6380

# === Identity provider (TBD — see docs/DECISIONS.md D-004) ===
AUTH_ISSUER_URL=
AUTH_AUDIENCE=
AUTH_JWKS_URI=

# === Sanity CMS ===
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_API_TOKEN=       # Server-side only; never expose to browser
SANITY_PREVIEW_SECRET=  # Protect preview webhooks

# === Payment gateway (TBD — see docs/DECISIONS.md D-005) ===
PAYMENT_PROVIDER=           # e.g. stripe, checkout, tap
PAYMENT_SECRET_KEY=         # Server-side only
PAYMENT_WEBHOOK_SECRET=     # For signature verification
PAYMENT_PUBLIC_KEY=         # Browser-safe publishable key only

# === POS integration (TBD — see docs/DECISIONS.md D-006) ===
POS_PROVIDER=
POS_API_URL=
POS_API_KEY=
POS_WEBHOOK_SECRET=

# === Object storage (TBD — see docs/DECISIONS.md D-011) ===
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# === Maps (TBD — see docs/DECISIONS.md D-013) ===
MAPS_BROWSER_API_KEY=   # HTTP referrer restricted
MAPS_SERVER_API_KEY=    # IP restricted; server-side only

# === Notifications (TBD — see docs/DECISIONS.md) ===
NOTIFICATIONS_PROVIDER=
NOTIFICATIONS_API_KEY=
NOTIFICATIONS_FROM_EMAIL=
NOTIFICATIONS_FROM_PHONE=

# === Observability ===
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
LOG_LEVEL=debug

# === Next.js ===
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_MAPS_BROWSER_API_KEY=   # Restricted key only

# === Feature flags ===
FEATURE_ORDERING_ENABLED=false
FEATURE_GIFT_CARDS_ENABLED=false
FEATURE_LOYALTY_ENABLED=false
FEATURE_SUBSCRIPTIONS_ENABLED=false
FEATURE_QR_ORDERING_ENABLED=false
