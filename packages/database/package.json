{
  "name": "@milestones/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma client and database utilities — ONLY importable by api and worker",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "db:generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "seed": "tsx src/seed.ts",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "7.10.1"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "tsx": "^4.19.4",
    "typescript": "7.0.2"
  }
}
