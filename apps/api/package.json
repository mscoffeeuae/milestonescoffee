{
  "name": "@milestones/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Milestones Coffee — NestJS business API",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.unit.config.ts --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@milestones/config": "workspace:*",
    "@milestones/contracts": "workspace:*",
    "@milestones/database": "workspace:*",
    "@milestones/i18n": "workspace:*",
    "@milestones/utilities": "workspace:*",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/swagger": "12.1.1",
    "bullmq": "6.7.4",
    "ioredis": "6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@nestjs/testing": "12.4.2",
    "@types/express": "5.0.0",
    "@types/node": "^22.0.0",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  }
}
